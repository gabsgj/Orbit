// ─────────────────────────────────────────────────────────────────────────────
// Orbit — canonical data model (mirrors docs/ER.md exactly).
// Schema-first per AGENTS.md §2: changes require a migration + team huddle.
// Owner: Gabriel. Money = Decimal(12,2). Time = timestamptz. Every FK indexed.
// ─────────────────────────────────────────────────────────────────────────────

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ── Enums ────────────────────────────────────────────────────────────────────

enum Role {
  ADMIN
  STAFF
  CUSTOMER
}

enum Period {
  DAILY
  WEEKLY
  MONTHLY
  YEARLY
}

enum SubscriptionStatus {
  DRAFT
  QUOTATION
  CONFIRMED
  ACTIVE
  PAUSED
  CLOSED
}

enum InvoiceStatus {
  DRAFT
  CONFIRMED
  PAID
  CANCELLED
}

enum InvoiceLineKind {
  PRODUCT
  TAX_SUMMARY
  DISCOUNT
}

enum DiscountKind {
  PERCENT
  FIXED
}

enum DiscountScope {
  PRODUCT
  SUBSCRIPTION
}

enum PaymentMethod {
  CASH
  BANK_TRANSFER
  CARD
  UPI
  CHEQUE
}

enum BillingTriggerType {
  MANUAL
  CRON_LOCAL
  CRON_VERCEL
}

enum BillingRunStatus {
  RUNNING
  DONE
  FAILED
}

enum OutboxKind {
  RESET
  INVOICE_SENT
  REMINDER
}

// ── Identity & access ────────────────────────────────────────────────────────

model User {
  id           String   @id @default(uuid()) @db.Uuid
  /// Lowercased at the service layer before write — uniqueness is case-insensitive by convention.
  email        String   @unique
  passwordHash String   @map("password_hash")
  role         Role
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  customer            Customer?
  passwordResetTokens PasswordResetToken[]
  statusChanges       SubscriptionStatusHistory[]
  paymentsRecorded    Payment[]               @relation("PaymentRecorder")
  billingRuns         BillingRun[]
  auditLogs           AuditLog[]

  @@map("users")
}

model Customer {
  id             String  @id @default(uuid()) @db.Uuid
  userId         String  @unique @map("user_id") @db.Uuid
  companyName    String  @map("company_name")
  billingAddress String? @map("billing_address")
  taxId          String? @map("tax_id")

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  subscriptions Subscription[]
  invoices      Invoice[]

  @@map("customers")
}

model PasswordResetToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(6)
  usedAt    DateTime? @map("used_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_tokens")
}

// ── Catalog ──────────────────────────────────────────────────────────────────

model Product {
  id         String   @id @default(uuid()) @db.Uuid
  name       String
  type       String // service | good
  salesPrice Decimal  @map("sales_price") @db.Decimal(12, 2)
  costPrice  Decimal  @map("cost_price") @db.Decimal(12, 2)
  notes      String?
  isActive   Boolean  @default(true) @map("is_active")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  variants            ProductVariant[]
  plans               Plan[]
  discountRuleProducts DiscountRuleProduct[]

  @@map("products")
}

model Attribute {
  id     String @id @default(uuid()) @db.Uuid
  name   String @unique // e.g. "Brand"
  values AttributeValue[]

  @@map("attributes")
}

model AttributeValue {
  id          String @id @default(uuid()) @db.Uuid
  attributeId String @map("attribute_id") @db.Uuid
  value       String // e.g. "Odoo"

  attribute Attribute        @relation(fields: [attributeId], references: [id], onDelete: Cascade)
  variants  ProductVariant[]

  @@unique([attributeId, value])
  @@index([attributeId])
  @@map("attribute_values")
}

model ProductVariant {
  id               String  @id @default(uuid()) @db.Uuid
  productId        String  @map("product_id") @db.Uuid
  attributeValueId String  @map("attribute_value_id") @db.Uuid
  priceExtra       Decimal @default(0) @map("price_extra") @db.Decimal(12, 2)

  product                Product                 @relation(fields: [productId], references: [id], onDelete: Cascade)
  attributeValue         AttributeValue          @relation(fields: [attributeValueId], references: [id])
  quotationTemplateLines QuotationTemplateLine[]
  subscriptionLines      SubscriptionLine[]
  invoiceLines           InvoiceLine[]

  @@unique([productId, attributeValueId])
  @@index([attributeValueId])
  @@map("product_variants")
}

model Plan {
  id            String   @id @default(uuid()) @db.Uuid
  productId     String   @map("product_id") @db.Uuid
  price         Decimal  @db.Decimal(12, 2)
  period        Period
  minQuantity   Int      @default(1) @map("min_quantity")
  availableFrom DateTime @map("available_from") @db.Date
  availableTo   DateTime @map("available_to") @db.Date
  autoClose     Boolean  @default(false) @map("auto_close")
  closableEarly Boolean  @default(false) @map("closable_early")
  pausable      Boolean  @default(false) @map("pausable")
  renewable     Boolean  @default(false) @map("renewable")
  isActive      Boolean  @default(true) @map("is_active")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  product            Product             @relation(fields: [productId], references: [id])
  subscriptions      Subscription[]
  quotationTemplates QuotationTemplate[]

  @@index([productId])
  @@map("plans")
}

model Tax {
  id          String   @id @default(uuid()) @db.Uuid
  name        String // e.g. "GST 18%"
  ratePercent Decimal  @map("rate_percent") @db.Decimal(5, 2)
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  lineTaxes SubscriptionLineTax[]

  @@map("taxes")
}

// ── Sales flow ───────────────────────────────────────────────────────────────

model QuotationTemplate {
  id           String @id @default(uuid()) @db.Uuid
  name         String
  planId       String @map("plan_id") @db.Uuid
  validityDays Int    @map("validity_days")
  isActive     Boolean @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  plan          Plan                    @relation(fields: [planId], references: [id])
  lines         QuotationTemplateLine[]
  subscriptions Subscription[]

  @@index([planId])
  @@map("quotation_templates")
}

model QuotationTemplateLine {
  id         String  @id @default(uuid()) @db.Uuid
  templateId String  @map("template_id") @db.Uuid
  variantId  String  @map("variant_id") @db.Uuid
  quantity   Int
  unitPrice  Decimal @map("unit_price") @db.Decimal(12, 2)

  template QuotationTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  variant  ProductVariant    @relation(fields: [variantId], references: [id])

  @@index([templateId])
  @@index([variantId])
  @@map("quotation_template_lines")
}

model Subscription {
  id               String             @id @default(uuid()) @db.Uuid
  number           String             @unique // SUB-2026-00042 (from sequences)
  customerId       String             @map("customer_id") @db.Uuid
  planId           String             @map("plan_id") @db.Uuid
  templateId       String?            @map("template_id") @db.Uuid
  startDate        DateTime           @map("start_date") @db.Date
  expiryDate       DateTime           @map("expiry_date") @db.Date
  paymentTermsDays Int                @default(15) @map("payment_terms_days")
  status           SubscriptionStatus @default(DRAFT)
  nextBillingDate  DateTime?          @map("next_billing_date") @db.Date
  pausedOn         DateTime?          @map("paused_on") @db.Date
  createdAt        DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)

  customer       Customer                    @relation(fields: [customerId], references: [id])
  plan           Plan                        @relation(fields: [planId], references: [id])
  template       QuotationTemplate?          @relation(fields: [templateId], references: [id])
  lines          SubscriptionLine[]
  statusHistory  SubscriptionStatusHistory[]
  invoices       Invoice[]

  /// Drives the billing engine: WHERE status='ACTIVE' AND next_billing_date <= asOf
  @@index([status, nextBillingDate])
  @@index([customerId])
  @@index([planId])
  @@map("subscriptions")
}

model SubscriptionLine {
  id             String  @id @default(uuid()) @db.Uuid
  subscriptionId String  @map("subscription_id") @db.Uuid
  variantId      String  @map("variant_id") @db.Uuid
  quantity       Int
  /// Snapshot at confirm time — never re-read from live catalog prices.
  unitPrice      Decimal @map("unit_price") @db.Decimal(12, 2)

  subscription Subscription           @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  variant     ProductVariant          @relation(fields: [variantId], references: [id])
  taxes       SubscriptionLineTax[]

  @@index([subscriptionId])
  @@index([variantId])
  @@map("subscription_lines")
}

model SubscriptionLineTax {
  lineId String @map("line_id") @db.Uuid
  taxId  String @map("tax_id") @db.Uuid

  line SubscriptionLine @relation(fields: [lineId], references: [id], onDelete: Cascade)
  tax  Tax              @relation(fields: [taxId], references: [id])

  @@id([lineId, taxId])
  @@index([taxId])
  @@map("subscription_line_taxes")
}

model SubscriptionStatusHistory {
  id             String             @id @default(uuid()) @db.Uuid
  subscriptionId String             @map("subscription_id") @db.Uuid
  fromStatus     SubscriptionStatus @map("from_status")
  toStatus       SubscriptionStatus @map("to_status")
  changedById    String             @map("changed_by") @db.Uuid
  changedAt      DateTime           @default(now()) @map("changed_at") @db.Timestamptz(6)
  note           String?

  subscription Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  changedBy    User         @relation(fields: [changedById], references: [id])

  @@index([subscriptionId])
  @@map("subscription_status_history")
}

// ── Discounts ────────────────────────────────────────────────────────────────

model DiscountRule {
  id          String        @id @default(uuid()) @db.Uuid
  name        String
  kind        DiscountKind
  value       Decimal       @db.Decimal(12, 2)
  minPurchase Decimal?      @map("min_purchase") @db.Decimal(12, 2)
  minQuantity Int?          @map("min_quantity")
  startDate   DateTime      @map("start_date") @db.Date
  endDate     DateTime      @map("end_date") @db.Date
  /// NULL = unlimited. Enforced by counting discount_usages transactionally.
  usageLimit  Int?          @map("usage_limit")
  scope       DiscountScope
  isActive    Boolean       @default(true) @map("is_active")
  createdAt   DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)

  products DiscountRuleProduct[]
  usages   DiscountUsage[]

  @@map("discount_rules")
}

model DiscountRuleProduct {
  ruleId    String @map("rule_id") @db.Uuid
  productId String @map("product_id") @db.Uuid

  rule    DiscountRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)
  product Product      @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([ruleId, productId])
  @@index([productId])
  @@map("discount_rule_products")
}

model DiscountUsage {
  id            String   @id @default(uuid()) @db.Uuid
  ruleId        String   @map("rule_id") @db.Uuid
  invoiceId     String   @map("invoice_id") @db.Uuid
  appliedAmount Decimal  @map("applied_amount") @db.Decimal(12, 2)
  appliedAt     DateTime @default(now()) @map("applied_at") @db.Timestamptz(6)

  rule    DiscountRule @relation(fields: [ruleId], references: [id])
  invoice Invoice      @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([ruleId])
  @@index([invoiceId])
  @@map("discount_usages")
}

// ── Billing & money ──────────────────────────────────────────────────────────

model Invoice {
  id             String        @id @default(uuid()) @db.Uuid
  number         String        @unique // INV-2026-00123 (from sequences)
  customerId     String        @map("customer_id") @db.Uuid
  subscriptionId String        @map("subscription_id") @db.Uuid
  billingRunId   String?       @map("billing_run_id") @db.Uuid
  issueDate      DateTime      @map("issue_date") @db.Date
  dueDate        DateTime      @map("due_date") @db.Date
  status         InvoiceStatus @default(DRAFT)
  subtotal       Decimal       @db.Decimal(12, 2)
  taxTotal       Decimal       @map("tax_total") @db.Decimal(12, 2)
  discountTotal  Decimal       @map("discount_total") @db.Decimal(12, 2)
  grandTotal     Decimal       @map("grand_total") @db.Decimal(12, 2)
  /// Documented denormalization (docs/ER.md): maintained transactionally by
  /// PaymentService so outstanding/overdue queries are indexed column reads.
  amountPaid     Decimal       @default(0) @map("amount_paid") @db.Decimal(12, 2)
  periodStart    DateTime      @map("period_start") @db.Date
  periodEnd      DateTime      @map("period_end") @db.Date
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)

  customer   Customer        @relation(fields: [customerId], references: [id])
  subscription Subscription @relation(fields: [subscriptionId], references: [id])
  billingRun BillingRun?     @relation(fields: [billingRunId], references: [id])
  lines      InvoiceLine[]
  payments   Payment[]
  discountUsages DiscountUsage[]

  /// ★ "Never billed twice": the database itself refuses a duplicate period.
  @@unique([subscriptionId, periodStart])
  @@index([customerId, status])
  @@index([dueDate])
  @@index([subscriptionId])
  @@map("invoices")
}

model InvoiceLine {
  id          String          @id @default(uuid()) @db.Uuid
  invoiceId   String          @map("invoice_id") @db.Uuid
  variantId   String?         @map("variant_id") @db.Uuid
  kind        InvoiceLineKind @default(PRODUCT) @map("kind")
  description String
  quantity    Int
  unitPrice   Decimal         @map("unit_price") @db.Decimal(12, 2)
  taxAmount   Decimal         @default(0) @map("tax_amount") @db.Decimal(12, 2)
  /// Snapshot at generation time — never recomputed from live prices.
  lineTotal   Decimal         @map("line_total") @db.Decimal(12, 2)

  invoice Invoice         @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  variant ProductVariant? @relation(fields: [variantId], references: [id])

  @@index([invoiceId])
  @@map("invoice_lines")
}

model Payment {
  id           String        @id @default(uuid()) @db.Uuid
  invoiceId    String        @map("invoice_id") @db.Uuid
  method       PaymentMethod
  amount       Decimal       @db.Decimal(12, 2)
  paidAt       DateTime      @map("paid_at") @db.Timestamptz(6)
  note         String?
  recordedById String        @map("recorded_by") @db.Uuid
  createdAt    DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)

  invoice    Invoice @relation(fields: [invoiceId], references: [id])
  recordedBy User    @relation("PaymentRecorder", fields: [recordedById], references: [id])

  @@index([invoiceId])
  @@map("payments")
}

model BillingRun {
  id                    String             @id @default(uuid()) @db.Uuid
  startedAt             DateTime           @default(now()) @map("started_at") @db.Timestamptz(6)
  finishedAt            DateTime?          @map("finished_at") @db.Timestamptz(6)
  triggerType           BillingTriggerType @map("trigger_type")
  triggeredById         String?            @map("triggered_by") @db.Uuid
  invoicesCreated       Int                @default(0) @map("invoices_created")
  skippedAlreadyBilled  Int                @default(0) @map("skipped_already_billed")
  errors                Int                @default(0)
  status                BillingRunStatus   @default(RUNNING)

  triggeredBy User?     @relation(fields: [triggeredById], references: [id])
  invoices    Invoice[]

  @@map("billing_runs")
}

// ── System ───────────────────────────────────────────────────────────────────

/// Gapless, race-safe document numbering: UPDATE … RETURNING inside the
/// document's transaction (see NumberingService, modules/admin).
model Sequence {
  docType    String
  year       Int
  lastNumber BigInt @default(0) @map("last_number")

  @@id([docType, year])
  @@map("sequences")
}

model EmailOutbox {
  id        String     @id @default(uuid()) @db.Uuid
  toEmail   String     @map("to_email")
  subject   String
  bodyHtml  String     @map("body_html")
  kind      OutboxKind
  createdAt DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  /// NULL = queued (offline mode). Set when dispatched (only if SMTP_URL configured).
  sentAt    DateTime?  @map("sent_at") @db.Timestamptz(6)

  @@index([createdAt])
  @@map("email_outbox")
}

model AuditLog {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  entity    String // e.g. "subscription"
  entityId  String   @map("entity_id") @db.Uuid
  action    String // e.g. "TRANSITION", "PAYMENT_RECORDED"
  meta      Json?
  at        DateTime @default(now()) @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id])

  @@index([entity, entityId])
  @@map("audit_log")
}
