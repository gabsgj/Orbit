# ── Database (local PostgreSQL — judged demo runs on this, fully offline) ──────
# Create with:  createuser orbit_app -P   /   createdb orbit -O orbit_app
DATABASE_URL="postgresql://orbit_app:orbit@localhost:5432/orbit?schema=public"

# ── Auth (next-auth) ─────────────────────────────────────────────────────────
# Generate:  openssl rand -base64 32
NEXTAUTH_SECRET="replace-me-with-a-long-random-string"
NEXTAUTH_URL="http://localhost:3000"

# ── Billing scheduler ────────────────────────────────────────────────────────
# Local worker cron expression (node-cron). Demo rehearsal mode: "*/2 * * * *"
BILLING_CRON="5 0 * * *"
# Shared secret for the hosted Vercel Cron endpoint (bonus mirror only)
CRON_SECRET="replace-me-for-hosted-deploy"

# ── Email (OPTIONAL — leave empty for offline demo; mail is staged in email_outbox) ──
SMTP_URL=""

# ── Hosted mirror (bonus, Vercel + Neon) — NOT needed for the judged local demo ──
# DATABASE_URL="postgresql://...neon.tech/orbit?sslmode=require"
